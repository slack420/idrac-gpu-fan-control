[Unit]
Description=Fanlaw read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/fanlaw-dash.py --unit gpu-fan-curve --listen 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
